{
  "name": "vr4all",
  "version": "0.3.73",
  "description": "Desktop installer for standalone Quest game ports",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start:desktop": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.vr4all.desktop",
    "productName": "VR4ALL",
    "asar": true,
    "files": [
      "desktop/main.js",
      "desktop/clipboard.js",
      "desktop/exit-guard.js",
      "desktop/preload.js",
      "desktop/profile-paths.js",
      "desktop/app-updater.js",
      "desktop/update-launcher.ps1",
      "desktop/update-helper.ps1",
      "desktop/icon.ico",
      "desktop/icon.png",
      "public/**/*",
      "!public/models/**",
      "src/**/*",
      "server.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VR4ALL-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/platform-tools",
          "to": "platform-tools"
        },
        {
          "from": "vendor/7zip",
          "to": "7zip"
        },
        {
          "from": "vendor/chdman",
          "to": "chdman"
        }
      ]
    },
    "linux": {
      "icon": "desktop/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "VR4ALL-linux-x64.${ext}"
    }
  }
}
